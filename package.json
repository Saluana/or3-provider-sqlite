{
    "name": "or3-provider-sqlite",
    "version": "0.0.4",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Saluana/or3-provider-sqlite.git"
    },
    "description": "SQLite sync and workspace store provider for OR3 Chat — lightweight self-hosted backend via Kysely.",
    "license": "MIT",
    "type": "module",
    "engines": {
        "node": ">=24"
    },
    "packageManager": "bun@1.3.14",
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./dist/types.d.mts",
            "import": "./dist/module.mjs"
        },
        "./nuxt": {
            "types": "./dist/types.d.mts",
            "import": "./dist/module.mjs"
        },
        "./webhooks/sqlite-store": {
            "types": "./dist/runtime/server/webhooks/sqlite-webhook-store.d.ts",
            "import": "./dist/runtime/server/webhooks/sqlite-webhook-store.js"
        }
    },
    "main": "./dist/module.mjs",
    "types": "./dist/types.d.mts",
    "files": [
        "dist"
    ],
    "scripts": {
        "prepack": "bun run build",
    "build": "nuxt-module-build build",
    "lint": "eslint src --max-warnings 0",
    "type-check": "tsc --noEmit",
    "type-check:standalone": "tsc -p tsconfig.release.json --noEmit",
    "test": "vitest run"
    },
    "publishConfig": {
        "access": "public"
    },
    "dependencies": {
        "kysely": "^0.28.11"
    },
    "optionalDependencies": {
        "better-sqlite3": "^12.6.2",
        "libsql": "^0.5.29"
    },
    "peerDependencies": {
        "@nuxt/kit": "^3.0.0 || ^4.0.0",
        "nuxt": "^3.0.0 || ^4.0.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.34.0",
        "@nuxt/module-builder": "^1.0.2",
        "@types/better-sqlite3": "^7.6.13",
        "@types/node": "^24.10.1",
        "@typescript-eslint/eslint-plugin": "^8.41.0",
        "@typescript-eslint/parser": "^8.41.0",
        "eslint": "^9.34.0",
        "h3": "^1.15.4",
        "pathe": "^2.0.3",
        "typescript": "^5.9.3",
        "vitest": "^4.0.18"
    }
}
