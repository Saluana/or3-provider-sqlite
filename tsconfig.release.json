{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noImplicitAny": false,
    "paths": {
      "h3": ["./node_modules/h3"],
      "~~/*": ["./src/shims/or3-chat-contract.ts"],
      "~~": ["./src/shims/or3-chat-contract.ts"],
